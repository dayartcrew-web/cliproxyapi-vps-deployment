# CLIProxyAPI VPS Deployment - Git Attributes
# Ensures consistent line endings and file handling across platforms

###############################################################################
# Auto-detect text files and normalize line endings to LF
###############################################################################
* text=auto eol=lf

###############################################################################
# Shell Scripts - MUST use LF (Linux line endings)
###############################################################################
*.sh text eol=lf
*.bash text eol=lf

###############################################################################
# Documentation
###############################################################################
*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.textile text eol=lf
*.mustache text eol=lf
*.csv text eol=lf
*.tab text eol=lf
*.tsv text eol=lf
*.sql text eol=lf

###############################################################################
# Configuration Files
###############################################################################
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.config text eol=lf
*.cnf text eol=lf

# Systemd service files
*.service text eol=lf

# Nginx config
nginx.conf text eol=lf
sites-available/* text eol=lf
sites-enabled/* text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

###############################################################################
# Git Config
###############################################################################
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
.gitkeep text eol=lf

###############################################################################
# Binary Files (no text conversion)
###############################################################################

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Certificates and keys
*.pem binary
*.key binary
*.crt binary
*.cert binary
*.p12 binary
*.pfx binary

###############################################################################
# Diff Settings
###############################################################################

# Shell scripts - show function names in diffs
*.sh diff=bash

# Markdown - treat as text
*.md diff=markdown

# YAML - treat as text
*.yml diff=yaml
*.yaml diff=yaml

###############################################################################
# Export Ignore (files excluded from git archive)
###############################################################################

# Don't include in releases
.gitattributes export-ignore
.gitignore export-ignore
*.backup* export-ignore
*.test export-ignore
test/ export-ignore
tests/ export-ignore
.vscode/ export-ignore
.idea/ export-ignore
